{
  "openapi": "3.1.0",
  "info": {
    "title": "API microfinance v1",
    "version": "1.0.0",
    "description": "API des applications mobiles (membres et collecteurs). Montants toujours en **centimes entiers** avec leur devise (jamais de nombre à virgule). Le serveur est la seule source de vérité : il recalcule soldes et disponibilités, et relit comptes et devises en base. Réponses JSON, erreurs sans trace technique. Voir ADR 005 et 022."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "jeton": []
    }
  ],
  "components": {
    "securitySchemes": {
      "jeton": {
        "type": "http",
        "scheme": "bearer",
        "description": "Jeton Sanctum. Capacités : `membre`, `collecteur` (lié à un téléphone autorisé) ou `personnel`."
      }
    },
    "schemas": {
      "Montant": {
        "type": "object",
        "properties": {
          "centimes": {
            "type": "integer",
            "description": "Montant en unité mineure (1/100)"
          },
          "devise": {
            "type": "string",
            "enum": [
              "USD",
              "CDF"
            ]
          },
          "texte": {
            "type": "string",
            "description": "Montant formaté, ex. « 1 250,50 USD »"
          }
        },
        "required": [
          "centimes",
          "devise",
          "texte"
        ]
      },
      "Jeton": {
        "type": "object",
        "properties": {
          "jeton": {
            "type": "string"
          },
          "expire_le": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResultatOperation": {
        "type": "object",
        "properties": {
          "cle": {
            "type": "string",
            "format": "uuid"
          },
          "statut": {
            "type": "string",
            "enum": [
              "cree",
              "deja_traite",
              "rejete"
            ]
          },
          "raison": {
            "type": "string"
          },
          "operation_id": {
            "type": "integer"
          },
          "recu": {
            "type": "string",
            "description": "Numéro du reçu officiel (dépôts, retraits)"
          }
        },
        "required": [
          "cle",
          "statut"
        ]
      },
      "OperationCollecte": {
        "type": "object",
        "properties": {
          "cle": {
            "type": "string",
            "format": "uuid",
            "description": "Générée au téléphone à la saisie ; rejouable sans doublon"
          },
          "type": {
            "type": "string",
            "enum": [
              "depot",
              "retrait",
              "cotisation",
              "remboursement"
            ]
          },
          "membre_id": {
            "type": "integer"
          },
          "compte_epargne_id": {
            "type": "integer",
            "description": "depot, retrait"
          },
          "pret_id": {
            "type": "integer",
            "description": "remboursement"
          },
          "cycle_id": {
            "type": "integer",
            "description": "cotisation (prochaine séance prévue)"
          },
          "montant_centimes": {
            "type": "integer"
          },
          "fonds_social_centimes": {
            "type": "integer",
            "description": "cotisation"
          },
          "parts": {
            "type": "integer",
            "description": "cotisation AVEC : 1 à parts_max"
          },
          "saisi_le": {
            "type": "string",
            "format": "date-time",
            "description": "Heure du téléphone, pour information et pour l'ordre de traitement"
          }
        },
        "required": [
          "cle",
          "type"
        ]
      }
    },
    "responses": {
      "Validation": {
        "description": "Données invalides",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "errors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/jetons": {
      "post": {
        "summary": "Jeton du personnel (mot de passe + OTP)",
        "description": "1er appel sans `code` : vérifie le mot de passe et envoie un code (202). 2e appel avec le code : jeton (201). Un collecteur doit envoyer `appareil_id` (UUID du téléphone) : téléphone inconnu → enregistré en attente, 403 `appareil_en_attente` ; révoqué → 403 `appareil_revoque`. 5 essais par minute.",
        "tags": [
          "Authentification"
        ],
        "responses": {
          "202": {
            "description": "Code envoyé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statut": {
                      "type": "string",
                      "enum": [
                        "code_requis"
                      ]
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Jeton délivré",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Jeton"
                }
              }
            }
          },
          "403": {
            "description": "Téléphone du collecteur en attente ou révoqué"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "429": {
            "description": "Trop de requêtes"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  },
                  "appareil": {
                    "type": "string",
                    "description": "Libellé du téléphone"
                  },
                  "appareil_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "code": {
                    "type": "string",
                    "description": "Code OTP"
                  }
                },
                "required": [
                  "email",
                  "password",
                  "appareil"
                ]
              }
            }
          }
        }
      }
    },
    "/auth/membre": {
      "post": {
        "summary": "Jeton d'un membre",
        "description": "Code de l'organisation + numéro de membre + mot de passe remis au guichet. `doit_changer_mot_de_passe` : tant qu'il vaut vrai, seule `/moi/mot-de-passe` répond. 5 essais par minute.",
        "tags": [
          "Authentification"
        ],
        "responses": {
          "201": {
            "description": "Jeton délivré",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jeton": {
                      "type": "string"
                    },
                    "expire_le": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "doit_changer_mot_de_passe": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "429": {
            "description": "Trop de requêtes"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organisation": {
                    "type": "string"
                  },
                  "numero": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "appareil": {
                    "type": "string"
                  }
                },
                "required": [
                  "organisation",
                  "numero",
                  "password",
                  "appareil"
                ]
              }
            }
          }
        }
      }
    },
    "/auth/deconnexion": {
      "post": {
        "summary": "Révoque le jeton courant",
        "description": "",
        "tags": [
          "Authentification"
        ],
        "responses": {
          "204": {
            "description": "Jeton révoqué"
          },
          "401": {
            "description": "Jeton absent, expiré ou révoqué"
          },
          "403": {
            "description": "Capacité du jeton insuffisante, téléphone non autorisé (`code: appareil_non_autorise`) ou mot de passe provisoire à changer (`code: mot_de_passe_a_changer`)"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "429": {
            "description": "Trop de requêtes"
          }
        }
      }
    },
    "/moi": {
      "get": {
        "summary": "Utilisateur connecté",
        "description": "",
        "tags": [
          "Authentification"
        ],
        "responses": {
          "200": {
            "description": "Utilisateur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "nom": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "telephone": {
                          "type": "string"
                        },
                        "organisation_id": {
                          "type": "integer"
                        },
                        "roles": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, expiré ou révoqué"
          },
          "403": {
            "description": "Capacité du jeton insuffisante, téléphone non autorisé (`code: appareil_non_autorise`) ou mot de passe provisoire à changer (`code: mot_de_passe_a_changer`)"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "429": {
            "description": "Trop de requêtes"
          }
        }
      }
    },
    "/moi/mot-de-passe": {
      "post": {
        "summary": "Change son mot de passe",
        "description": "Obligatoire après un mot de passe provisoire. 8 caractères au moins, lettres et chiffres.",
        "tags": [
          "Authentification"
        ],
        "responses": {
          "204": {
            "description": "Mot de passe changé"
          },
          "401": {
            "description": "Jeton absent, expiré ou révoqué"
          },
          "403": {
            "description": "Capacité du jeton insuffisante, téléphone non autorisé (`code: appareil_non_autorise`) ou mot de passe provisoire à changer (`code: mot_de_passe_a_changer`)"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "429": {
            "description": "Trop de requêtes"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actuel": {
                    "type": "string"
                  },
                  "nouveau": {
                    "type": "string"
                  },
                  "nouveau_confirmation": {
                    "type": "string"
                  }
                },
                "required": [
                  "actuel",
                  "nouveau",
                  "nouveau_confirmation"
                ]
              }
            }
          }
        }
      }
    },
    "/appareils": {
      "get": {
        "summary": "Ses jetons actifs",
        "description": "",
        "tags": [
          "Authentification"
        ],
        "responses": {
          "200": {
            "description": "Liste paginée"
          },
          "401": {
            "description": "Jeton absent, expiré ou révoqué"
          },
          "403": {
            "description": "Capacité du jeton insuffisante, téléphone non autorisé (`code: appareil_non_autorise`) ou mot de passe provisoire à changer (`code: mot_de_passe_a_changer`)"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "429": {
            "description": "Trop de requêtes"
          }
        }
      }
    },
    "/appareils/{id}": {
      "delete": {
        "summary": "Révoque un de ses jetons",
        "description": "Le jeton d'un autre utilisateur donne 404.",
        "tags": [
          "Authentification"
        ],
        "responses": {
          "204": {
            "description": "Révoqué"
          },
          "404": {
            "description": "Inconnu"
          },
          "401": {
            "description": "Jeton absent, expiré ou révoqué"
          },
          "403": {
            "description": "Capacité du jeton insuffisante, téléphone non autorisé (`code: appareil_non_autorise`) ou mot de passe provisoire à changer (`code: mot_de_passe_a_changer`)"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "429": {
            "description": "Trop de requêtes"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/membre/comptes": {
      "get": {
        "summary": "Comptes d'épargne du membre",
