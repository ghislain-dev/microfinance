                          "id": {
                            "type": "integer"
                          },
                          "type": {
                            "type": "string"
                          },
                          "libelle": {
                            "type": "string"
                          },
                          "montant": {
                            "$ref": "#/components/schemas/Montant"
                          },
                          "frais": {
                            "$ref": "#/components/schemas/Montant"
                          },
                          "recu": {
                            "type": "string"
                          },
                          "le": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent, expiré ou révoqué"
          },
          "403": {
            "description": "Capacité du jeton insuffisante, téléphone non autorisé (`code: appareil_non_autorise`) ou mot de passe provisoire à changer (`code: mot_de_passe_a_changer`)"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "429": {
            "description": "Trop de requêtes"
          }
        },
        "parameters": [
          {
            "name": "compte",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "depuis",
            "in": "query",
            "required": false,
            "description": "Horodatage ISO 8601 : seulement les éléments créés ou modifiés après.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ]
      }
    },
