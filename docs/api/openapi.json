    "/membre/notifications": {
      "get": {
        "summary": "Historique des notifications du membre",
        "description": "Pagination par curseur (`suivant`).",
        "tags": [
          "Membre"
        ],
        "responses": {
          "200": {
            "description": "Notifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "titre": {
