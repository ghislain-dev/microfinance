        ],
        "responses": {
          "200": {
            "description": "Comptes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "numero": {
                            "type": "string"
                          },
                          "produit": {
                            "type": "string"
                          },
                          "devise": {
                            "type": "string"
                          },
                          "solde": {
